# Real-Time Recommendation, Feature Store & Experimentation Platform
# Copy to .env and customize for local or containerized runs.
# NEVER commit real secrets or production tokens.

RECSYS_ENV=local_native
RECSYS_DATA_DIR=.local_data
RECSYS_API_HOST=127.0.0.1
RECSYS_API_PORT=8030
RECSYS_SEED=42

# API key RBAC configuration (dev/demo defaults; rotate via secret manager in production)
RECSYS_ADMIN_API_KEY=dev-admin-key-change-me
RECSYS_ANALYST_API_KEY=dev-analyst-key-change-me
RECSYS_SERVING_API_KEY=dev-serving-key-change-me

# Distributed backends (used when running Docker Compose full/core profile)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APICURIO_REGISTRY_URL=http://localhost:8081
VALKEY_URL=redis://localhost:6379/0
VALKEY_ENABLED=false
ICEBERG_CATALOG_URI=http://localhost:8181
OBJECT_STORE_ENDPOINT=http://localhost:9000
POSTGRES_CATALOG_DSN=postgresql://recsys:recsys@localhost:5432/catalog_db
MLFLOW_TRACKING_URI=file:./results/mlruns
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ARCH=arm64

# Feature store and experiment defaults
FEATURE_FRESHNESS_SLO_SECONDS=300
SESSION_INACTIVITY_GAP_SECONDS=1800
WATERMARK_ALLOWED_LATENESS_SECONDS=300
USER_STATE_TTL_SECONDS=86400
DEFAULT_EXPERIMENT_ID=exp_recsys_ranker_v2
DEFAULT_EXPERIMENT_SALT=recsys-platform-salt-2026
