{
  "type": "record",
  "name": "PlaybackInteractionV2",
  "namespace": "com.recsys.events.v2",
  "aliases": ["com.recsys.events.v1.PlaybackInteractionV1"],
  "doc": "Backward-compatible v2 interaction schema adding nullable client telemetry fields.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": {
      "type": "enum",
      "name": "InteractionType",
      "symbols": [
        "IMPRESSION",
        "PLAY_START",
        "HEARTBEAT",
        "PAUSE",
        "COMPLETE",
        "SKIP",
        "SEARCH",
        "THUMBS_UP",
        "THUMBS_DOWN",
        "DEVICE_SWITCH",
        "SUBSCRIPTION_UPGRADE"
      ]
    }},
    {"name": "user_id", "type": "string"},
    {"name": "item_id", "type": "string"},
    {"name": "device_id", "type": "string"},
    {"name": "device_type", "type": "string"},
    {"name": "event_ts_ms", "type": "long"},
    {"name": "ingest_ts_ms", "type": "long"},
    {"name": "watch_seconds", "type": "double", "default": 0.0},
    {"name": "position_seconds", "type": "double", "default": 0.0},
    {"name": "rebuffer_count", "type": "int", "default": 0},
    {"name": "search_query", "type": ["null", "string"], "default": null},
    {"name": "experiment_id", "type": ["null", "string"], "default": null},
    {"name": "experiment_variant", "type": ["null", "string"], "default": null},
    {"name": "source_system", "type": "string", "default": "playback-gateway"},
    {"name": "schema_version", "type": "int", "default": 2},
    {"name": "device_os_version", "type": ["null", "string"], "default": null, "doc": "Optional client OS telemetry added in v2."},
    {"name": "playback_bitrate_kbps", "type": ["null", "int"], "default": null, "doc": "Optional adaptive bitrate telemetry added in v2."}
  ]
}
