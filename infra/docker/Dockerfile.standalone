FROM python:3.12.8-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    RECSYS_API_HOST=0.0.0.0 \
    RECSYS_API_PORT=8030

WORKDIR /app

RUN groupadd --system recsys && useradd --system --gid recsys --create-home recsys

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY recsys_platform ./recsys_platform
COPY apps ./apps
COPY services ./services
COPY schemas ./schemas
COPY feast_repo ./feast_repo
COPY models ./models
COPY scripts ./scripts

RUN uv sync --frozen --no-dev \
    && chmod +x /app/scripts/entrypoint_standalone.sh \
    && mkdir -p /app/.local_data /app/results/mlruns \
    && chown -R recsys:recsys /app

USER recsys
EXPOSE 8030

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD /app/.venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8030/health', timeout=3)"

ENTRYPOINT ["/app/scripts/entrypoint_standalone.sh"]
